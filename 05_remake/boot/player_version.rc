// player_version.rc - version information and manifest of the players' exe (Recoil Redux.exe, RECOIL_PLAYER_RELEASE).
// An unsigned exe without them was taken for malware by Windows Defender's machine-learning check (2026-10-20,
// Behavior:Win32/DefenseEvasion.A!ml). Not Recoil data (PLATFORM).
#include <winver.h>

1 RT_MANIFEST "player.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Recoil Remake project"
            VALUE "FileDescription", "Recoil Redux - fan rebuild of Recoil (1999) for modern Windows"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Recoil Redux"
            VALUE "LegalCopyright", "GNU GPL v3 or later. Recoil (c) 1999 Electronic Arts / Zipper Interactive; not affiliated."
            VALUE "OriginalFilename", "Recoil Redux.exe"
            VALUE "ProductName", "Recoil Redux"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
